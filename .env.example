# Copy this file to ".env" and fill in your key.
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Models. Google retires/renames models often (Gemini 1.5 Pro is already gone).
# Run "python scripts/list_models.py" to see what your key can use.
GEMINI_PRO_MODEL=gemini-3.1-pro-preview
GEMINI_PRO_FALLBACKS=gemini-pro-latest,gemini-2.5-pro
GEMINI_FLASH_MODEL=gemini-3.8-flash
GEMINI_FLASH_FALLBACKS=gemini-flash-latest,gemini-2.5-flash

# If every Pro model fails (e.g. free-tier quota), use a Flash model for plans instead
GEMINI_ALLOW_FLASH_FALLBACK=true

# Database (default: fitbuddy.db in the project root)
# DATABASE_URL=sqlite:///./fitbuddy.db

# Set to true to run without calling Gemini (canned responses, for demos/tests)
FITBUDDY_MOCK_AI=false
